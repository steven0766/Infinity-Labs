#full compile
alias gd='gcc -ansi -pedantic-errors -Wall -Wextra -g'
alias gc='gcc -ansi -pedantic-errors -Wall -Wextra -DNDEBUG -O3'
alias gd9='gcc -std=c99 -pedantic-errors -Wall -Wextra -g'
alias gc9='gcc -std=c99 -pedantic-errors -Wall -Wextra -DNDEBUG -O3'
#alias for git
alias gs='git status'
alias ga='git add'
alias gp='git push'
alias gb='git branch'
#Valgrind alias
alias vlg='valgrind --leak-check=yes --track-origins=yes'
#compile before linking
alias go='gcc -c'

# C++ 98 
alias gdpp='g++ -std=c++98 -pedantic -Wall -Wextra -g'
alias gcpp='g++ -std=c++98 -pedantic -Wall -Wextra -DNDEBUG -O3'

# C++ 20
alias gdpp20='g++ -std=c++20 -pedantic -Wall -Wextra -g'
alias gcpp20='g++ -std=c++20 -pedantic -Wall -Wextra -DNDEBUG -O3'

# Clang 
alias cldpp='clang++ -std=c++98 -pedantic -Wall -Wextra -g'
alias clcpp='clang++ -std=c++98 -pedantic -Wall -Wextra -g -DNDEBUG -O3'
alias cldpp20='clang++ -std=c++20 -pedantic -Wall -Wextra -g'
alias clcpp20='clang++ -std=c++20 -pedantic -Wall -Wextra -g -DNDEBUG -O3'
