#full compile
alias gd='gcc -ansi -pedantic-errors -Wall -Wextra -g'
alias gc='gcc -ansi -pedantic-errors -Wall -Wextra -DNDEBUG -O3'
alias gd9='gcc -std=c99 -pedantic-errors -Wall -Wextra -g'
alias gc9='gcc -std=c99 -pedantic-errors -Wall -Wextra -DNDEBUG -O3'
#alias for git
alias gs='git status'
alias ga='git add'
alias gp='git push'
alias gb='git branch'
#Valgrind alias
alias vlg='valgrind --leak-check=yes --track-origins=yes'
#compile before linking
alias go='gcc -c'

#c
alias c-build='gcc -Wall -Wextra -std=c11'
alias c-strict='gcc -Wall -Wextra -Werror -std=c11'
#c++ debug
alias cpp-debug='g++ -Wall -Wextra -std=c++11 -g -O0'
alias cpp-debug-strict='g++ -Wall -Wextra -Werror -std=c++11 -g -O0'
#c++ release
alias cpp-release='g++ -Wall -Wextra -std=c++11 -O2 -DNDEBUG'
alias cpp-release-strict='g++ -Wall -Wextra -Werror -std=c++11 -O2 -DNDEBUG'
